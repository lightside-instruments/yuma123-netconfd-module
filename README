# Overview
ietf-hardware-state module for netconfd.

# Dependencies
Installed netconfd and yangcli
 apt-get install netconfd yangcli

# Installation
 autoreconf -i -f
 ./configure CFLAGS="-g -O0"  CXXFLAGS="-g -O0" --prefix=/usr
 make
 make install

# Testing installation
 echo "Port 830" >> /etc/ssh/sshd_config
 echo "/usr/sbin/netconf-subsystem" >> /etc/ssh/sshd_config
 /etc/init.d/ssh restart
 netconfd --module=ietf-hardware-state  --no-startup --superuser=$USER

# Alternatively if you need the lsi-storage-drive-ext augmentation
 netconfd --module=lsi-storage-drive-ext --module=ietf-hardware-state --no-startup --superuser=$USER

Other terminal:
 yangcli --server=localhost --user=$USER


yangcli vladimir@localhost> xget /hardware
...

