# Overview

YANG module of a display that can be configured to show binary image formated as JPEG file.


# Dependencies
Installed netconfd and yangcli
 apt-get install netconfd yangcli

# Installation
 apt install libx11-dev libjpeg-dev libyuma-dev
 autoreconf -i -f
 ./configure CFLAGS="-g -O0"  CXXFLAGS="-g -O0" --prefix=/usr
 make
 make install

# Testing installation

 netconfd --module=lsi-display  --no-startup --superuser=$USER

Other terminal:
 yangcli --server=localhost --user=$USER

...

# note the "..." below substitutes the base64 data for brevity
 cat ~/image.jpg | base64 --wrap=0
 /9j/4AAQSkZJRgABAQEBLAEsAAD//gATQ.../2Q==


 yangcli pi@localhost> create /displays/display[name='default'] -- image="/9j/4AAQSkZJRgABAQEBLAEsAAD//gATQ.../2Q=="
 
 yangcli pi@localhost> commit
 
 yangcli pi@localhost>


# Starting from rc.local with xinit - kiosk mode
...
xinit /usr/sbin/netconfd --module=lsi-display &
...

# Display 1920x1080 test pattern
cd example
python3 display-test-pattern.py --networks=networks.xml

# or display a 1920x1080 JPG image
python3 display-image.py --networks=networks.xml --image=/tmp/image.jpg
