==Starting multiple netconfd server instances on different ports on startup==
# Have users netconf-superuser and netconf-user created
# Recommended password: netconf

(penv) root@raspberrypi:/home/pi/netconfd-10831# cat thermometers-get
#!/usr/bin/bash
python3 ./thermometers-get-airthings-ble-wave-plus

(penv) root@raspberrypi:/home/pi/netconfd-10831# cat /etc/rc.local 
#!/bin/sh -e
export USER=root
export HOME=/root

export PATH=.:$PATH

cd /home/pi/netconfd-830
export AIRTHINGS_DEVICE_ID="9876543210"
export AIRTHINGS_CLIENT_ID="aa54bf61-77a2-4f98-a1d0-1a9c20a66666"
export AIRTHINGS_CLIENT_SECRET="43b7e7e4-c0d3-4e7e-af50-7e583bbbbbbb"
source ./penv/bin/activate
export PATH=.:$PATH
netconfd --no-startup --module=lsi-thermometers --superuser=netconf-superuser 1>netconfd.log 2>netconfd.stderr.log &

cd /home/pi/netconfd-10831
mkdir /tmp/netconfd-10831
rm tmp || true
ln -s /tmp/netconfd-10831 tmp
export AIRTHINGS_DEVICE_ID="0123456789"
source ./penv/bin/activate
export PATH=.:$PATH
netconfd --no-startup --module=lsi-thermometers --superuser=netconf-superuser --port=10831 --ncxserver-sockname=/tmp/ncxserver-10831.sock 1>netconfd.log 2>netconfd.stderr.log &


