#!/usr/bin/python3

import os
import requests

# Set environment variables for security (recommended) or replace directly
CLIENT_ID = os.getenv("AIRTHINGS_CLIENT_ID", "your_client_id")
CLIENT_SECRET = os.getenv("AIRTHINGS_CLIENT_SECRET", "your_client_secret")
DEVICE_ID = os.getenv("AIRTHINGS_DEVICE_ID", "your_device_serial_number")

# API Endpoints
AUTH_URL = f"https://accounts-api.airthings.com/v1/token"
#API_URL = f"https://airthings.com/{DEVICE_ID}/latest-samples"
API_URL = f"https://ext-api.airthings.com/v1/devices/{DEVICE_ID}/latest-samples"
#API_URL = f"https://ext-api.airthings.com/v1/devices/{DEVICE_ID}"
def get_data():
    """Authenticates and fetches data from Airthings API."""
    # 1. Get Access Token
    auth_response = requests.post(
        AUTH_URL,
        data={"grant_type": "client_credentials"},
        auth=(CLIENT_ID, CLIENT_SECRET),
        timeout=10
    )
    auth_response.raise_for_status()
    token = auth_response.json()["access_token"]

    # 2. Fetch Device Data
    headers = {"Authorization": f"Bearer {token}"}
    data_response = requests.get(API_URL, headers=headers, timeout=10)
    data_response.raise_for_status()
    return data_response.json()

if __name__ == "__main__":
    try:
        print(get_data())
    except Exception as e:
        print(f"Error: {e}")
